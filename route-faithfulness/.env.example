# Copy this file to .env and fill in the keys you use.
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
# Only for a self-hosted vLLM server; any string works if the server has no key.
VLLM_API_KEY=EMPTY
# Only if the Hugging Face dataset needs a login.
HF_TOKEN=
# Free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Claude API key (claude_sonnet46)
ANTHROPIC_API_KEY=sk-ant-...
# Vertex AI (gemini35_flash, judge, claude_sonnet46_vertex) uses gcloud Application Default Credentials,
# not a key: run `gcloud auth application-default login` once. Only the project ID goes here.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Optional: Gemini Developer API key (gemini35_flash_apikey), from https://aistudio.google.com/apikey
GEMINI_API_KEY=
